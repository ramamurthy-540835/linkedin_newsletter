APP_NAME=LinkedIn Post Agent
ENV=dev
HOST=0.0.0.0
PORT=8000
LOCAL_DEV_MODE=true
LOCAL_DB_PATH=backend/data/content_studio.db
DISABLE_GCP=true
DISABLE_BIGQUERY=true
DISABLE_VERTEX_AI=true

GCP_PROJECT_ID=
GCP_REGION=us-central1
VERTEX_MODEL=gemini-2.5-flash
AI_PROVIDER=xai
DEFAULT_AI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
XAI_API_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback
LINKEDIN_AUTHOR_URN=

CLOUD_TASKS_QUEUE=linkedin-post-schedule
CLOUD_TASKS_LOCATION=us-central1
CLOUD_RUN_BASE_URL=http://localhost:8000
